# Copy to /opt/finance-tracker/.env.production on the VPS. Never commit real secrets.
APP_ORIGIN=https://YOUR_VPS_IP
# Nginx requires fullchain.pem and privkey.pem in /opt/finance-tracker/tls.
# See docs/deployment.md to generate a certificate for IP access.
# Use hex secrets so the password is also safe inside DATABASE_URL.
# Generate each value separately with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_IN=7d

TELEGRAM_BOT_TOKEN=
GOOGLE_CLIENT_ID=
AI_PROVIDER=gemini
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_MODEL=
AI_TIMEOUT_MS=60000
