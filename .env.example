# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finance_tracker?schema=public"
REDIS_URL="redis://localhost:6379"

# CORS (comma-separated dashboard origins)
CORS_ORIGIN="http://localhost:3000"

# Telegram
# Bot token from @BotFather. Leave empty to disable the bot entirely.
# The bot long-polls, so only one instance may poll with a given token.
TELEGRAM_BOT_TOKEN=""

# OCR (PaddleOCR sidecar; Docker Compose sets the internal service URL)
OCR_BASE_URL="http://localhost:8000"

# AI
AI_PROVIDER="gemini"
AI_API_KEY="your-google-ai-studio-api-key"
AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
AI_MODEL="gemini-3.8-flash"
AI_TIMEOUT_MS="60000"

# Auth
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
# Google OAuth web client ID. Use the same value for backend and dashboard.
GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Next.js Dashboard
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXTAUTH_SECRET="your-nextauth-secret-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Email (optional, for magic links)
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT=""
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM=""
