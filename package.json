{
  "name": "finance-tracker",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/turbo/bin/turbo run dev --env-mode=loose",
    "build": "node --env-file-if-exists=.env node_modules/turbo/bin/turbo run build --filter=@finance-tracker/backend --filter=@finance-tracker/dashboard --filter=@finance-tracker/shared",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:migrate": "turbo run db:migrate",
    "db:studio": "turbo run db:studio"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23",
      "dompurify": "^3.4.17",
      "js-yaml": "^4.3.2",
      "lodash": "^4.18.0",
      "qs": "^6.16.1",
      "source-map-js": "^1.2.2",
      "multer": "^2.5.0"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
